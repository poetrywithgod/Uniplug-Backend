// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  ADMISSION_OFFICER
  HOD
  LECTURER
  EXAMINATION_OFFICER
  FINANCE_OFFICER
  HOSTEL_MANAGER
  HOSTEL_STAFF
  STUDENT
  APPLICANT
  PARENT
}

enum ApprovalStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ApplicationStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  OFFER_ISSUED
  OFFER_ACCEPTED
  OFFER_DECLINED
  APPROVED
  REJECTED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum StudyMode {
  FULL_TIME
  PART_TIME
  DISTANCE_LEARNING
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum DocumentType {
  OLEVEL_RESULT
  HIGHER_QUALIFICATION_CERTIFICATE
  TRANSCRIPT
  JAMB_RESULT
  PASSPORT_PHOTOGRAPH
  BIRTH_CERTIFICATE
  LGA_CERTIFICATE
  ID_PASSPORT
  NYSC_CERTIFICATE
  CV
  STATEMENT_OF_PURPOSE
  REFERENCE_LETTERS
  CERTIFICATE
  OTHER
}

enum Semester {
  FIRST_SEMESTER
  SECOND_SEMESTER
}



type PersonalDetails {
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  phoneNumber String
  email       String
}

type AcademicRecord {
  institution          String
  highestQualification String
  graduationYear       Int
  overallGrade         String
}

type ProgrammeSelection {
  facultyId        String?
  faculty          String?
  departmentId     String?
  course           String?
  studyMode        StudyMode
  admissionPathway String?
}



type UploadedDocument {
  documentType DocumentType
  fileUrl      String
  uploadedAt   DateTime     @default(now())
}

model Tenant {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  schoolName         String
  schoolId           String              @unique
  email              String
  school             String
  address            String
  postalCode         String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  applications       Application[]
  hostels            Hostel[]
  hostelApplications HostelApplication[]
  departments        Department[]
  courses            Course[]
  courseOfferings    CourseOffering[]
  courseAssignments  CourseAssignment[]
  courseEnrollments  CourseEnrollment[]
  grades             Grade[]
  faculties           Faculty[]
  academicSessions    AcademicSession[]
  academicSemesters   AcademicSemester[]
  programmes          Programme[]
  programmeEnrollments ProgrammeEnrollment[]
  admissionOffers     AdmissionOffer[]
}

model User {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  firstName           String
  lastName            String
  email               String              @unique
  adminId             String?             @unique
  phoneNumber         String?
  staffId             String?
  departmentId        String?             @db.ObjectId
  department          Department?         @relation("DepartmentStaff", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school              String?
  schoolId            String?
  tenantId            String?             @db.ObjectId
  tenant              Tenant?             @relation(fields: [tenantId], references: [id])
  role                Role
  isVerified          Boolean             @default(false)
  approvalStatus      ApprovalStatus      @default(VERIFIED)
  approvalRemark      String?
  level               Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  // Decoupled credentials
  credential          Credential?

  applications        Application[]
  hostelApplications  HostelApplication[]
  courseEnrollments   CourseEnrollment[]
  grades              Grade[]             @relation("StudentGrades")
  gradesGiven         Grade[]             @relation("GradedByLecturer")
  gradesApproved      Grade[]             @relation("ApprovedByHOD")
  courseAssignments   CourseAssignment[]  @relation("LecturerAssignments")
  assignedByMe        CourseAssignment[]  @relation("AssignedByHOD")
  departmentsOwned    Department[]        @relation("DepartmentHOD")
  programmeEnrollments ProgrammeEnrollment[]
  offersGiven          AdmissionOffer[]     @relation("OfficerIssuedOffers")
  myOffers             AdmissionOffer[]     @relation("ApplicantOffers")
}

model Credential {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String    @unique @db.ObjectId
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash        String
  emailOtpHash        String?
  emailOtpExpiresAt   DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Application {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  applicationNumber String? @unique
  applicantId       String  @db.ObjectId
  schoolId          String  @db.ObjectId

  status             ApplicationStatus @default(DRAFT)
  session            String?
  rejectionReason    String?
  progressPercentage Int               @default(0)

  personalDetails    PersonalDetails?
  academicHistory    AcademicRecord?
  programmeSelection ProgrammeSelection?
  documents          UploadedDocument[]

  offer              AdmissionOffer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicant User   @relation(fields: [applicantId], references: [id])
  school    Tenant @relation(fields: [schoolId], references: [id])

  @@unique([applicantId, schoolId])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, session, createdAt])
  @@index([schoolId, createdAt])
}

enum HostelType {
  MALE
  FEMALE
  MIXED
}

enum HostelApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Hostel {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  type         HostelType
  capacity     Int
  price        Float
  totalRooms   Int
  totalBlocks  Int
  totalWings   Int
  spacePerRoom Int
  tenantId     String     @db.ObjectId
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  pictures     String[]   @default([])

  createAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications HostelApplication[]

  @@index([tenantId])
}

model HostelApplication {
  id              String                  @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String                  @db.ObjectId
  student         User                    @relation(fields: [studentId], references: [id])
  hostelId        String                  @db.ObjectId
  hostel          Hostel                  @relation(fields: [hostelId], references: [id])
  tenantId        String                  @db.ObjectId
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  status          HostelApplicationStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([hostelId, status])
  @@index([tenantId])
}

model Department {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  hodId     String?     @db.ObjectId
  hod       User?       @relation("DepartmentHOD", fields: [hodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facultyId String?     @db.ObjectId
  faculty   Faculty?    @relation(fields: [facultyId], references: [id])
  tenantId  String      @db.ObjectId
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  courses   Course[]
  programmes Programme[]
  staff     User[]      @relation("DepartmentStaff")

  @@index([tenantId])
  @@index([facultyId])
}

model Faculty {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  code        String       @unique
  tenantId    String       @db.ObjectId
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
}

model AcademicSession {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  name         String             // e.g. "2025/2026"
  isActive     Boolean            @default(false)
  tenantId     String             @db.ObjectId
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  semesters    AcademicSemester[]
  enrollments  ProgrammeEnrollment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([tenantId, name])
}

model AcademicSemester {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  name      Semester
  isActive  Boolean         @default(false)
  sessionId String          @db.ObjectId
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenantId  String          @db.ObjectId
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([sessionId, name])
}

model Programme {
  id                String                @id @default(auto()) @map("_id") @db.ObjectId
  name              String                // e.g. "BSc Computer Science"
  code              String                @unique
  durationYears     Int
  creditRequirement Int
  category          String                // Undergraduate Degree, ND, HND, NCE, etc.
  departmentId      String                @db.ObjectId
  department        Department            @relation(fields: [departmentId], references: [id])
  tenantId          String                @db.ObjectId
  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  enrollments       ProgrammeEnrollment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([tenantId])
  @@index([departmentId])
}

enum ProgrammeEnrollmentStatus {
  ACTIVE
  GRADUATED
  SPILLOVER
  WITHDRAWN
}

model ProgrammeEnrollment {
  id                    String                    @id @default(auto()) @map("_id") @db.ObjectId
  studentId             String                    @db.ObjectId
  student               User                      @relation(fields: [studentId], references: [id])
  programmeId           String                    @db.ObjectId
  programme             Programme                 @relation(fields: [programmeId], references: [id])
  startSessionId        String                    @db.ObjectId
  startSession          AcademicSession           @relation(fields: [startSessionId], references: [id])
  entryLevel            String                    // e.g. "100 Level", "ND I"
  currentLevel          String                    // e.g. "200 Level", "ND II"
  admissionPathway      String                    // UTME, Direct Entry, Internal Progression, Conversion, Transfer
  isActive              Boolean                   @default(true)
  status                ProgrammeEnrollmentStatus @default(ACTIVE)
  lastPromotedSessionId String?                   @db.ObjectId
  tenantId              String                    @db.ObjectId
  tenant                Tenant                    @relation(fields: [tenantId], references: [id])
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([tenantId])
  @@index([studentId])
}

enum CourseCategory {
  CORE
  ELECTIVE
  GENERAL_STUDIES
}

model Course {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  courseName     String
  courseCode     String           @unique
  creditUnits    Int
  level          Int
  semester       Semester
  category       CourseCategory
  description    String?
  departmentId   String           @db.ObjectId
  department     Department       @relation(fields: [departmentId], references: [id])
  createdByHodId String           @db.ObjectId
  status         String           @default("ACTIVE")
  tenantId       String           @db.ObjectId
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  offerings      CourseOffering[]

  @@index([tenantId])
  @@index([departmentId])
}

type CourseSchedule {
  venue     String
  day       String
  time      String
  updatedAt DateTime @default(now())
}

type CourseSyllabus {
  title       String?
  description String?
  fileUrl     String?
  fileName    String?
  uploadedAt  DateTime @default(now())
}

type CourseMaterial {
  id         String   @default(cuid())
  title      String
  fileUrl    String
  fileType   String
  fileSize   Int?
  uploadedAt DateTime @default(now())
}

model CourseOffering {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  courseId        String             @db.ObjectId
  course          Course             @relation(fields: [courseId], references: [id])
  academicSession String
  status          String             @default("ACTIVE")

  tenantId        String             @db.ObjectId
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  schedule        CourseSchedule?
  syllabus        CourseSyllabus?
  materials       CourseMaterial[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  assignments     CourseAssignment[]
  enrollments     CourseEnrollment[]
  grades          Grade[]

  @@index([tenantId])
  @@index([courseId])
}

enum AssignmentStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum LecturerRole {
  LEAD_LECTURER
  CO_LECTURER
  TA
}

model CourseAssignment {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  courseOfferingId String           @db.ObjectId
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id])
  lecturerId       String           @db.ObjectId
  lecturer         User             @relation("LecturerAssignments", fields: [lecturerId], references: [id])
  assignedById     String?          @db.ObjectId
  assignedBy       User?            @relation("AssignedByHOD", fields: [assignedById], references: [id])
  status           AssignmentStatus @default(PENDING)
  role             LecturerRole     @default(LEAD_LECTURER)
  tenantId         String           @db.ObjectId
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
  @@index([courseOfferingId])
  @@index([lecturerId])
}

enum EnrollmentStatus {
  PENDING_APPROVAL
  ENROLLED
  REJECTED
}

model CourseEnrollment {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  studentId        String           @db.ObjectId
  student          User             @relation(fields: [studentId], references: [id])
  courseOfferingId String           @db.ObjectId
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id])
  status           EnrollmentStatus @default(PENDING_APPROVAL)
  tenantId         String           @db.ObjectId
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([courseOfferingId])
}

enum GradeStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Grade {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  studentId        String         @db.ObjectId
  student          User           @relation("StudentGrades", fields: [studentId], references: [id])
  courseOfferingId String         @db.ObjectId
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id])
  caScore          Float?         @default(0)
  examScore        Float?         @default(0)
  score            Float          // Total score: caScore + examScore
  letterGrade      String?
  remarks          String?
  gradedById       String         @db.ObjectId
  gradedBy         User           @relation("GradedByLecturer", fields: [gradedById], references: [id])
  status           GradeStatus    @default(PENDING_APPROVAL)
  isApproved       Boolean        @default(false)
  approvedById     String?        @db.ObjectId
  approvedBy       User?          @relation("ApprovedByHOD", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?
  tenantId         String         @db.ObjectId
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentId, courseOfferingId])
  @@index([tenantId])
  @@index([studentId])
  @@index([courseOfferingId])
}

model AdmissionOffer {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  applicationId       String      @unique @db.ObjectId
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicantId         String      @db.ObjectId
  applicant           User        @relation("ApplicantOffers", fields: [applicantId], references: [id])
  tenantId            String      @db.ObjectId
  tenant              Tenant      @relation(fields: [tenantId], references: [id])

  originalCourse      String
  originalFaculty     String

  offeredCourse       String
  offeredFaculty      String
  offeredDepartmentId String?     @db.ObjectId

  isAlternativeOffer  Boolean     @default(false)
  status              OfferStatus @default(PENDING)
  remarks             String?
  expiresAt           DateTime?

  issuedById          String      @db.ObjectId
  issuedBy            User        @relation("OfficerIssuedOffers", fields: [issuedById], references: [id])

  acceptedAt          DateTime?
  declinedAt          DateTime?
  declineReason       String?

  offerLetterUrl      String?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([tenantId])
  @@index([applicantId])
  @@index([issuedById])
}
